pipeline {
    agent any

    environment {
        BROWSERSTACK_USERNAME   = credentials('BROWSERSTACK_USERNAME')
        BROWSERSTACK_ACCESS_KEY = credentials('BROWSERSTACK_ACCESS_KEY')
    }

    stages {
        stage('Checkout Code') {
            steps {
                checkout scm
            }
        }

        stage('Execute BrowserStack Tests') {
            steps {

                bat '"C:\\Program Files\\apache-maven-3.9.16\\bin\\mvn.cmd" clean test -DsuiteXmlFile=testng.xml'
            }
        }
    }

    post {
        always {
            junit '**/target/surefire-reports/*.xml'
        }
    }
}
