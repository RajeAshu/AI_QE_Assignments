<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="API Test Automation Suite">


    <parameter name="os" value=""/>
    <parameter name="osVersion" value=""/>
    <parameter name="browserName" value=""/>
    <parameter name="browserVersion" value=""/>


    <test name="Regression and Smoke Executions">
        <parameter name="os" value="Windows"/>
        <parameter name="osVersion" value="11"/>
        <parameter name="browserName" value="chrome"/>
        <parameter name="browserVersion" value="latest"/>
        <classes>
            <class name="AddRemoveElementTest" />
        </classes>
    </test>


    <test name="iPhoneTest">
        <parameter name="deviceName" value="iPhone 13"/>
        <parameter name="osVersion" value="15"/>
        <parameter name="realMobile" value="true"/>
        <classes>
            <class name="AddRemoveElementTest" />
        </classes>
    </test>

    <test name="Android">
        <parameter name="deviceName" value="Galaxy S24 Ultra"/>
        <parameter name="osVersion" value="14"/>
        <parameter name="realMobile" value="true"/>
        <classes>
            <class name="AddRemoveElementTest" />
        </classes>
    </test>

    <!-- Mobile Test: Tablet / Alternative Android -->
    <test name="iPad">
        <parameter name="deviceName" value="OnePlus 12R"/>
        <parameter name="osVersion" value="14"/>
        <parameter name="realMobile" value="true"/>
        <classes>
            <class name="AddRemoveElementTest" />
        </classes>
    </test>


    <test name="Windows Chrome Test">
        <parameter name="os" value="Windows"/>
        <parameter name="osVersion" value="10"/>
        <parameter name="browserName" value="chrome"/>
        <parameter name="browserVersion" value="latest"/>
        <classes>
            <class name="AddRemoveElementTest" />
        </classes>
    </test>

</suite>
